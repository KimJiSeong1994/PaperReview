# Required
OPENAI_API_KEY=your-openai-api-key
JWT_SECRET=your-jwt-secret-min-32-chars

# Environment: "production" enforces JWT_SECRET requirement, "development" allows random fallback
ENVIRONMENT=development

# Optional
SEARCH_MODEL=gpt-6-luna    # Search planning, HyDE, ReAct and query keywords only; other model defaults unchanged
TYPESAFE_API_KEY=          # Server-only: enables live JEV reranking; absent disables it. Offline eval still requires --allow-network.
DATA_DIR=data              # Base directory for data files (bookmarks, users, papers, workspace)
KCI_DB_PATH=data/kci.db     # Harvested SQLite corpus; deployed separately from application code
KCI_RETRIEVAL_MODE=baseline # baseline | ppr | spectral; spectral is experimental, bounded to 128 candidates
S2_API_KEY=                # Semantic Scholar API key (relaxes citation tree rate limits)
DBLP_SEARCH_BACKEND=auto   # auto: REST with official SPARQL recovery; sparql skips the website API
GOOGLE_API_KEY=            # Google Gemini API key (poster generation)
GOOGLE_CLIENT_ID=          # Google Web OAuth client ID (*.apps.googleusercontent.com). Enables Google-only sign-in and one-time legacy account linking; no client secret required.
CORS_ORIGINS=              # Allowed origins, comma-separated (default: jiphyeonjeon.kr,localhost)
LEGACY_PASSWORD_SALT=      # First 16 chars of original JWT_SECRET (for legacy SHA-256 password migration)
